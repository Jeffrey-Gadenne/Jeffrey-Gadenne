ANTHROPIC_API_KEY=sk-ant-...
# Long random string — keeps logins valid across server restarts.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# PORT=3000
# NODE_ENV=production   # enable in production: makes session cookies HTTPS-only
# ALLOW_ANONYMOUS=true  # local tinkering only: disables the login requirement
# ALLOW_SIGNUPS=false   # closes self-serve registration

# --- Plans & billing (all optional; billing UI hidden until Stripe vars are set) ---
# See README "Recommended launch configuration" for suggested values.
# FREE_MONTHLY_QUOTA=3
# PRO_MONTHLY_QUOTA=100
# PLAN_PRICE_DISPLAY=A$29/month
# PACK_CREDITS=5
# PACK_PRICE_DISPLAY=A$7
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...          # recurring price (Pro subscription)
# STRIPE_PACK_PRICE_ID=price_...     # one-off price (credit pack)
# STRIPE_WEBHOOK_SECRET=whsec_...
# APP_URL=https://your-app.azurewebsites.net   # used in Stripe redirect URLs
# MODEL=claude-sonnet-5                        # recommended: ~half the cost of claude-opus-4-8
