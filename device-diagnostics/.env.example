ANTHROPIC_API_KEY=sk-ant-...
# Long random string — keeps logins valid across server restarts.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# PORT=3000
# NODE_ENV=production   # enable in production: makes session cookies HTTPS-only
# ALLOW_ANONYMOUS=true  # local tinkering only: disables the login requirement
# ALLOW_SIGNUPS=false   # closes self-serve registration

# --- Plans & billing (all optional; billing UI hidden until Stripe vars are set) ---
